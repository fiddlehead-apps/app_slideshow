    "Nothing from this slideshow is saved yet. Choose the folder again to save it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von dieser Diashow ist noch nichts gespeichert. Wähle den Ordner noch einmal, um sie zu speichern."
