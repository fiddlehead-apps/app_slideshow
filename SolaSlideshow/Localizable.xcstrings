{
  "sourceLanguage" : "en",
  "strings" : {
    "%lld images" : {
      "comment" : "Number of images in a saved slideshow",
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld Bild"
