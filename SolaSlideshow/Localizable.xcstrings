      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mediathek"
          }
        }
      }
    },
    "Make a copy" : {
      "comment" : "Confirm button",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopie anlegen"
          }
        }
      }
    },
    "Make a copy of all images?" : {
      "comment" : "Question before a copy of a very big folder or album is made",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Bilder kopieren?"
          }
        }
      }
    },
    "Make an album in the Photos app and it shows up here." : {
      "comment" : "Album list is empty",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege in der Fotos-App ein Album an, dann erscheint es hier."
          }
        }
      }
    },
    "Media types" : {
      "comment" : "Section in the album list: Selfies, Portrait, Panoramas, Screenshots, …",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medienarten"
