    },
    "No portrait images in this slideshow." : {
      "comment" : "Shown instead of the slideshow when the image format setting leaves nothing to show",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Diashow gibt es keine Bilder im Hochformat."
