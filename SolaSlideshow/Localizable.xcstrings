    "Seconds" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekunden"
          }
        }
      }
    },
    "Sola Slideshow plays every image in a folder – or photos you pick – full screen." : {
      "comment" : "“Sola Slideshow” is the app name (German: “Sola Diashow”)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sola Diashow zeigt alle Bilder eines Ordners – oder Fotos, die du auswählst – im Vollbild."
          }
        }
      }
    },
    "Move “%@” to hidden" : {
      "comment" : "Confirm button; %@ is the slideshow name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ verstecken"
          }
        }
      }
    },
    "Move %@ back to Your slideshows" : {
      "comment" : "Accessibility label of the eye button in the hidden list; %@ is the slideshow name",
