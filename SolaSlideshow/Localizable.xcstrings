      "comment" : "Title of the list behind Face ID",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versteckte Diashows"
          }
        }
      }
    },
    "Hide this slideshow?" : {
      "comment" : "Title of the dialog after tapping a slideshow five times",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Diashow verstecken?"
          }
        }
      }
    },
    "How it works" : {
      "comment" : "Title of the help screen",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So funktioniert’s"
          }
        }
      }
    },
    "Image format" : {
      "comment" : "Heading of the setting that shows all images, or only portrait or only landscape ones",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildformat"
          }
        }
      }
    },
    "Images stay on this device. Nothing is uploaded." : {
      "comment" : "Footer on the start screen",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bilder bleiben auf diesem Gerät. Nichts wird hochgeladen."
          }
        }
      }
    },
    "It disappears from this list and only shows up in the hidden slideshows." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie verschwindet aus dieser Liste und ist nur noch bei den versteckten Diashows zu sehen."
          }
        }
      }
    },
    "It is also removed from iCloud and from your other devices." : {
      "comment" : "Explains what deleting the copy does when the slideshow is synced",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wird auch aus iCloud und von deinen anderen Geräten entfernt."
          }
        }
      }
    },
    "Keep a copy on this device" : {
      "comment" : "Switch in the settings of a slideshow that plays from a folder or an album",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopie auf diesem Gerät behalten"
          }
        }
      }
    },
    "Landscape" : {
      "comment" : "Image format setting: only images wider than tall",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Querformat"
          }
        }
      }
    },
    "landscape only" : {
      "comment" : "Part of a slideshow summary: shows only landscape images",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nur Querformat"
          }
        }
      }
    },
