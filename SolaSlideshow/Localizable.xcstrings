    "%lld of %lld saved. Choose the folder again to finish." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld von %lld gespeichert. Wähle den Ordner noch einmal, um den Rest zu speichern."
          }
        }
      }
    },
    "%lld s" : {
      "comment" : "Seconds per image",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld s"
          }
        }
      }
    },
    "All" : {
      "comment" : "Image format setting: show every image",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbrechen"
          }
        }
      }
    },
    "Choose a different image format in the settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle in den Einstellungen ein anderes Bildformat."
          }
        }
      }
    },
    "Choose another folder" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anderen Ordner wählen"
