        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minuten"
          }
        }
      }
    },
    "My albums" : {
      "comment" : "Section in the album list: albums the user made in Photos",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Alben"
          }
        }
      }
    },
    "No albums with photos" : {
      "comment" : "Album list is empty",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Alben mit Fotos"
          }
        }
      }
    },
    "No copy of “%@” could be made: none of its images could be read." : {
      "comment" : "%@ is the slideshow name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von „%@“ konnte keine Kopie angelegt werden: Keines der Bilder ließ sich lesen."
          }
        }
      }
    },
    "No landscape images in this slideshow." : {
      "comment" : "Shown instead of the slideshow when the image format setting leaves nothing to show",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Diashow gibt es keine Bilder im Querformat."
          }
        }
      }
    },
    "No portrait images in this slideshow." : {
      "comment" : "Shown instead of the slideshow when the image format setting leaves nothing to show",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In dieser Diashow gibt es keine Bilder im Hochformat."
          }
        }
      }
    },
    "None of the images from “%@” could be read, so there is no slideshow." : {
      "comment" : "%@ is the slideshow name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keines der Bilder aus „%@“ ließ sich lesen, deshalb gibt es keine Diashow."
          }
        }
      }
    },
    "None of this slideshow’s images are on this device yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von dieser Diashow ist noch kein Bild auf diesem Gerät."
          }
        }
      }
    },
    "Off unless you turn it on. Then the slideshows that have a copy, and the settings for new slideshows, sync through your private iCloud database to your devices with the same Apple Account. A slideshow without a copy stays on the device that has its folder or album. The copies count toward your iCloud storage." : {
      "comment" : "Help text",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aus, solange du es nicht einschaltest. Dann werden die Diashows mit Kopie und die Einstellungen für neue Diashows über deine private iCloud-Datenbank mit deinen Geräten mit demselben Apple Account synchronisiert. Eine Diashow ohne Kopie bleibt auf dem Gerät, das ihren Ordner oder ihr Album hat. Die Kopien zählen zu deinem iCloud-Speicher."
          }
        }
      }
    },
    "Only %lld of %lld images were saved." : {
      "comment" : "Status of a slideshow of single photos or files whose copying was interrupted",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur %lld von %lld Bildern wurden gespeichert."
          }
        }
      }
    },
    "Open Settings" : {
      "comment" : "Opens the app’s page in the Settings app",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einstellungen öffnen"
          }
        }
      }
    },
    "Opening your album…" : {
      "comment" : "Shown while the picked album is read",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album wird geöffnet …"
          }
        }
      }
    },
    "Photos that are only in iCloud are downloaded while the slideshow plays." : {
      "comment" : "Shown while the picked album is read",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos, die nur in iCloud liegen, werden geladen, während die Diashow läuft."
          }
        }
      }
    },
    "Pick a folder in Files or an album in Photos and every image in it plays full screen." : {
      "comment" : "Start screen intro below the headline",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen Ordner in Dateien oder ein Album in Fotos, und alle Bilder darin laufen im Vollbild."
          }
        }
      }
    },
    "Plays without the folder or album, also offline" : {
      "comment" : "Below the switch “Keep a copy on this device”",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft ohne den Ordner oder das Album, auch offline"
          }
        }
      }
    },
    "Plays without the folder or album, also offline, and syncs with iCloud" : {
      "comment" : "Below the switch “Keep a copy on this device” when iCloud sync is on",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft ohne den Ordner oder das Album, auch offline, und wird mit iCloud synchronisiert"
          }
        }
      }
    },
    "Plays without the folder or album, also offline. Uses %@." : {
      "comment" : "Below the switch “Keep a copy on this device”; %@ is a size like 86 MB",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft ohne den Ordner oder das Album, auch offline. Belegt %@."
          }
        }
      }
    },
    "Portrait" : {
      "comment" : "Image format setting: only images taller than wide",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hochformat"
          }
        }
      }
    },
    "portrait only" : {
      "comment" : "Part of a slideshow summary: shows only portrait images",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "nur Hochformat"
          }
        }
      }
    },
    "Seconds" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sekunden"
          }
        }
      }
    },
    "Move “%@” to hidden" : {
      "comment" : "Confirm button; %@ is the slideshow name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ verstecken"
          }
        }
      }
    },
    "Move %@ back to Your slideshows" : {
