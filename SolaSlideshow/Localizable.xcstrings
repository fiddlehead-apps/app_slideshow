    "What it does" : {
      "comment" : "Help heading",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was die App macht"
          }
        }
      }
    },
    "While it plays" : {
      "comment" : "Help heading",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während sie läuft"
          }
        }
      }
    },
    "Your device reads every file in the folder before the slideshow can start. Big folders or photos that are only in iCloud Drive can take a moment. Nothing is uploaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gerät liest jede Datei im Ordner, bevor die Diashow starten kann. Große Ordner oder Fotos, die nur in iCloud Drive liegen, können einen Moment dauern. Nichts wird hochgeladen."
          }
        }
      }
    },
    "Your slideshows" : {
      "comment" : "Heading of the list of saved slideshows",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Diashows"
          }
        }
      }
    },
    "Couldn’t delete the data in iCloud: %@" : {
      "comment" : "Turning off iCloud sync with deletion failed; %@ is the system's error message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Daten in iCloud konnten nicht gelöscht werden: %@"
